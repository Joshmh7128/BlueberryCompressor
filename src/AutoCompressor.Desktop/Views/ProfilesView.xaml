<UserControl x:Class="AutoCompressor.Desktop.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="372" />
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <DockPanel Margin="0,0,14,0">
            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                <Button Command="{Binding NewCommand}" Content="New" HorizontalAlignment="Stretch" Margin="0,0,4,6" />
                <Button Command="{Binding DuplicateCommand}" Content="Duplicate" HorizontalAlignment="Stretch" Margin="4,0,0,6" />
                <Button Command="{Binding DeleteCommand}" Content="Delete" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="Delete a custom profile" />
                <Button Command="{Binding ResetCommand}" Content="Reset" HorizontalAlignment="Stretch" Margin="4,0,0,0" ToolTip="Put a built-in profile back to its original settings" />
            </UniformGrid>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource SoftListItem}" Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Custom" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BuiltIn}" Value="True">
                                                <Setter Property="Text" Value="Built-in" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Editor -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,14,18,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Content="Save changes" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Command="{Binding RevertCommand}" Content="Discard" />
                        <StackPanel>
                            <TextBlock Text="{Binding Editing.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                    <StackPanel DataContext="{Binding Editing}" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Name">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="340" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Description">
                            <TextBox Text="{Binding Description}" Width="440" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Container"
                                                Visibility="{Binding DataContext.IsVideo, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <ComboBox ItemsSource="{Binding DataContext.VideoContainers, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Container}" Width="340" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="File format"
                                                Visibility="{Binding DataContext.IsAudio, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <ComboBox ItemsSource="{Binding DataContext.AudioContainers, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Container}" Width="340" />
                        </HeaderedContentControl>

                        <!-- Video -->
                        <StackPanel Visibility="{Binding DataContext.IsVideo, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Video" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Codec">
                                <ComboBox ItemsSource="{Binding DataContext.Codecs, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Codec}" Width="340" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Encoder"
                                                    Tag="Software encoders make the smallest files. Hardware (NVENC, Quick Sync, AMF) is many times faster.">
                                <ComboBox ItemsSource="{Binding DataContext.EncoderPreferences, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Encoder}" Width="340" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Rate control">
                                <ComboBox ItemsSource="{Binding DataContext.RateModes, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding RateMode}" Width="340" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Quality (CRF)"
                                                    Tag="Lower is better and bigger. Typical HEVC values: 18-20 very high, 22-24 good, 26-28 small. AV1 uses a 0-63 scale where 30 is roughly HEVC 23.">
                                <TextBox Text="{Binding Quality}" Width="90" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Hardware quality offset"
                                                    Tag="Added to the quality value when a GPU encoder is used, whose scale runs a few points lower for the same result.">
                                <TextBox Text="{Binding HardwareQualityOffset}" Width="90" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Target bitrate (kbps)" Tag="Used when rate control is Average bitrate.">
                                <TextBox Text="{Binding BitrateKbps}" Width="90" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Bitrate ceiling (kbps)" Tag="Optional cap on peaks. 0 means no cap.">
                                <TextBox Text="{Binding MaxBitrateKbps}" Width="90" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Speed" Tag="Slower presets give smaller files at the same quality.">
                                <ComboBox ItemsSource="{Binding DataContext.Speeds, ElementName=Root}" SelectedItem="{Binding Speed}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Tune" Tag="animation suits flat colour and line art; grain keeps film grain; film is for live action (H.264).">
                                <ComboBox ItemsSource="{Binding DataContext.Tunes, ElementName=Root}" SelectedItem="{Binding Tune}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Bit depth" Tag="HDR video is always kept at 10-bit.">
                                <ComboBox ItemsSource="{Binding DataContext.BitDepths, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding BitDepth}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Maximum resolution" Tag="Larger video is scaled down; smaller video is never scaled up.">
                                <ComboBox ItemsSource="{Binding DataContext.Heights, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding MaxHeight}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Maximum frame rate" Tag="50 and 60 fps are halved rather than resampled, so motion stays even.">
                                <ComboBox ItemsSource="{Binding DataContext.FrameRates, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding MaxFps}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Deinterlace">
                                <ComboBox ItemsSource="{Binding DataContext.DeinterlaceModes, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Deinterlace}" Width="260" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Noise reduction" Tag="Removing noise before encoding saves bits but softens fine detail.">
                                <ComboBox ItemsSource="{Binding DataContext.DenoiseLevels, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Denoise}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Encoder parameters"
                                                    Tag="Passed to the software encoder as-is, colon separated. Example for x265: aq-mode=3:psy-rd=1.0">
                                <TextBox Text="{Binding EncoderParams}" Width="440" FontFamily="{StaticResource Mono}" />
                            </HeaderedContentControl>
                        </StackPanel>

                        <!-- Audio -->
                        <TextBlock Text="Audio" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Codec">
                            <ComboBox ItemsSource="{Binding DataContext.AudioCodecs, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding AudioCodec}" Width="340" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Bitrate (kbps)" Tag="Chosen by how many channels a track has after any downmix.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mono" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding MonoKbps}" Width="62" />
                                <TextBlock Text="Stereo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox Text="{Binding StereoKbps}" Width="62" />
                                <TextBlock Text="5.1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox Text="{Binding SurroundKbps}" Width="62" />
                                <TextBlock Text="7.1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                <TextBox Text="{Binding Surround71Kbps}" Width="62" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Channels">
                            <ComboBox ItemsSource="{Binding DataContext.ChannelLimits, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding MaxChannels}" Width="200" />
                        </HeaderedContentControl>
                        <StackPanel Visibility="{Binding DataContext.IsVideo, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Small tracks"
                                                    Tag="A track already in the target codec is never re-encoded. This extends that to small tracks in other codecs.">
                                <CheckBox Content="Copy tracks that are already at or under the target bitrate" IsChecked="{Binding CopyEfficientAudio}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Languages to keep" Tag="Codes such as eng, jpn. Leave empty to keep every track. Unlabelled tracks are always kept.">
                                <TextBox Text="{Binding AudioLanguages}" Width="200" />
                            </HeaderedContentControl>
                        </StackPanel>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Lossless sources" Tag="What to do with WAV, FLAC, ALAC and similar files."
                                                Visibility="{Binding DataContext.IsAudio, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <ComboBox ItemsSource="{Binding DataContext.LosslessPolicies, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding LosslessSource}" Width="340" />
                        </HeaderedContentControl>

                        <!-- Subtitles and extras -->
                        <StackPanel Visibility="{Binding DataContext.IsVideo, ElementName=Root, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Subtitles and extras" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Subtitles">
                                <ComboBox ItemsSource="{Binding DataContext.SubtitleModes, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Subtitles}" Width="340" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Subtitle languages" Tag="Only used with “Keep selected languages”.">
                                <TextBox Text="{Binding SubtitleLanguages}" Width="200" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="If the container can't hold a format"
                                                    Tag="MKV holds nearly everything. MP4 cannot hold ASS or picture-based (PGS, VobSub) subtitles.">
                                <ComboBox ItemsSource="{Binding DataContext.SubtitleFallbacks, ElementName=Root}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SubtitleFallback}" Width="340" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Field}" Header="Keep">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Chapters" IsChecked="{Binding KeepChapters}" Margin="0,0,18,0" />
                                    <CheckBox Content="Fonts and attachments" IsChecked="{Binding KeepAttachments}" Margin="0,0,18,0" />
                                    <CheckBox Content="Tags" IsChecked="{Binding KeepMetadata}" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>

                        <TextBlock Text="When to leave a file alone" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Skip below (kbps)"
                                                Tag="Video: files whose video bitrate is already under this (at 1080p; scaled for other sizes) are skipped. It applies in full to HEVC, AV1 and VP9 and at 60% to older codecs. Audio: lossy files at or under this bitrate are skipped. 0 never skips.">
                            <TextBox Text="{Binding SkipBelowKbps}" Width="90" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Style="{StaticResource Field}" Header="Extra ffmpeg arguments" Tag="Added to the end of the command, before the output file.">
                            <TextBox Text="{Binding ExtraArgs}" Width="440" FontFamily="{StaticResource Mono}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Which profile each content type gets -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="14,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Automatic assignment" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="Each file is recognised as one of these types and gets the profile chosen here. Individual files can still be changed in the Library." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="106" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="10" Padding="9,2,9,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            Background="{Binding Type, Converter={StaticResource TypeBrush}, ConverterParameter=fill}">
                                        <TextBlock Text="{Binding TypeName}" FontSize="12" Foreground="{Binding Type, Converter={StaticResource TypeBrush}}" />
                                    </Border>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                                              HorizontalAlignment="Stretch" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
