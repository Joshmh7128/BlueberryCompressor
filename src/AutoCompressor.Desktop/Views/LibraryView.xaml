<UserControl x:Class="AutoCompressor.Desktop.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AutoCompressor.Desktop.Controls">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="236" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel LastChildFill="False">
            <Button Click="AddFolder_Click" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    Content="Add folder" Tag="&#xE8F4;" ContentTemplate="{StaticResource IconLabel}" />
            <Button Click="AddFiles_Click" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    Content="Add files" Tag="&#xE8E5;" ContentTemplate="{StaticResource IconLabel}" />
            <Button Command="{Binding RescanCommand}" Content="Rescan" Margin="0,0,8,0" ToolTip="Scan the added folders again" />
            <Button Command="{Binding ClearCommand}" Content="Clear" Margin="0,0,8,0" ToolTip="Empty this list. Nothing on disk is touched." />
            <Button Click="Export_Click" Content="Export list" ToolTip="Save the listed files and their details as a spreadsheet (CSV)" />

            <Button DockPanel.Dock="Right" Command="{Binding QueueAllCommand}" Content="Queue all listed" Margin="8,0,0,0"
                    ToolTip="Add every file in the list to the queue. Files that are already compressed are left out." />
            <Button DockPanel.Dock="Right" Command="{Binding QueueSelectedCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0"
                    Content="Queue selected" Tag="&#xE710;" ContentTemplate="{StaticResource IconLabel}"
                    ToolTip="Add the selected files, or every file inside the selected folders, to the queue" />
            <ComboBox DockPanel.Dock="Right" Width="218" Margin="8,0,0,0" ItemsSource="{Binding EncoderPolicies}" DisplayMemberPath="Value"
                      SelectedValuePath="Key" SelectedValue="{Binding EncoderPolicy}" ToolTip="Which kind of encoder to use for profiles that do not insist on one" />
            <ComboBox DockPanel.Dock="Right" Width="198" Margin="8,0,0,0" ItemsSource="{Binding OutputModes}" DisplayMemberPath="Value"
                      SelectedValuePath="Key" SelectedValue="{Binding OutputMode}" ToolTip="Where compressed files go. More options are in Settings." />
        </DockPanel>

        <!-- View switch and filters -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="7" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding FileView}" Content="Files by size" GroupName="LibraryView"
                                 ToolTip="Every file in one list, largest first" />
                    <RadioButton Style="{StaticResource Segment}" IsChecked="{Binding FolderView}" Content="Folders" GroupName="LibraryView"
                                 ToolTip="Folders and files together, each showing how much of its parent it takes up" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource GhostButton}" Command="{Binding ExpandAllCommand}" Content="Expand all" Margin="8,0,0,0" Foreground="{StaticResource TextMuted}"
                    Visibility="{Binding FolderView, Converter={StaticResource VisibleWhen}}" />
            <Button Style="{StaticResource GhostButton}" Command="{Binding CollapseAllCommand}" Content="Collapse all" Foreground="{StaticResource TextMuted}"
                    Visibility="{Binding FolderView, Converter={StaticResource VisibleWhen}}" />

            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <CheckBox DockPanel.Dock="Right" Content="Hide compressed" IsChecked="{Binding HideCompressed}" VerticalAlignment="Center" Margin="10,0,0,0" />
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" />
            <Grid DockPanel.Dock="Right" Width="230">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,5,8,6" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="Filter by name or path" Foreground="{StaticResource TextFaint}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="31,0,0,1"
                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
            </Grid>
        </DockPanel>

        <!-- Progress and notices -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Background="{StaticResource Card}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Content="Cancel" Padding="10,3" />
                    <c:Bar DockPanel.Dock="Right" Width="180" Height="5" VerticalAlignment="Center" Margin="12,0" Track="{StaticResource Track}"
                           Fill="{StaticResource Accent}" Fraction="{Binding BusyFraction}" />
                    <TextBlock Text="{Binding BusyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding ToolsMissing, Converter={StaticResource VisibleWhen}}">
                <TextBlock TextWrapping="Wrap" Text="ffmpeg was not found, so files cannot be inspected or compressed. Install it (for example: winget install Gyan.FFmpeg) or point to ffmpeg.exe in Settings." />
            </Border>
            <Border Background="{StaticResource Card}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding HasNotice, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="DismissNotice_Click" Padding="6,4" ToolTip="Dismiss"
                            Content="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- The list -->
        <DataGrid x:Name="RowsGrid" Grid.Row="3" Style="{StaticResource Grid}" ItemsSource="{Binding Rows}"
                  SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown"
                  CanUserSortColumns="{Binding FileView}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Add to queue" Command="{Binding QueueSelectedCommand}" />
                    <Separator />
                    <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                    <MenuItem Header="Back to automatic type and profile" Command="{Binding ResetSelectionCommand}" />
                    <MenuItem Header="Remove from this list" Command="{Binding RemoveSelectedCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" MinWidth="260" SortMemberPath="Name" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}" ToolTip="{Binding FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- In folder view every row reserves the expander's width so names line up -->
                                <Grid Width="22" Visibility="{Binding DataContext.FolderView, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource VisibleWhen}}">
                                    <Button Style="{StaticResource GhostButton}" Padding="0" Width="20" Height="20" Click="Expander_Click" Focusable="False"
                                            Visibility="{Binding IsFolder, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="{Binding ExpanderGlyph}" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{StaticResource TextMuted}" />
                                    </Button>
                                </Grid>
                                <Grid Grid.Column="1" Width="16" Margin="2,0,9,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource TextFaint}"
                                               Visibility="{Binding IsFile, Converter={StaticResource VisibleWhen}}" />
                                    <Path Data="{StaticResource FolderShape}" Fill="#E8B95A" Width="16" Height="15.5" Stretch="None"
                                          Visibility="{Binding IsFolder, Converter={StaticResource VisibleWhen}}" />
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource CellText}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="SizeColumn" Header="Size" Width="172" SortMemberPath="Size" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding SizeTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <c:Bar Height="8" Fraction="{Binding SizeFraction}" Track="{StaticResource Track}" VerticalAlignment="Center">
                                    <c:Bar.Style>
                                        <Style TargetType="c:Bar">
                                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter Property="Fill" Value="#E8B95A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:Bar.Style>
                                </c:Bar>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CellTextRight}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" Width="66" SortMemberPath="DurationSeconds"
                                    ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource GridHeaderRight}" />
                <DataGridTextColumn Header="Video" Binding="{Binding VideoText}" Width="156" ElementStyle="{StaticResource CellTextMuted}" />
                <DataGridTextColumn Header="Audio" Binding="{Binding AudioText}" Width="92" ElementStyle="{StaticResource CellTextMuted}" />
                <DataGridTextColumn Header="Subtitles" Binding="{Binding SubsText}" Width="92" ElementStyle="{StaticResource CellTextMuted}" />
                <DataGridTextColumn Header="Bitrate" Binding="{Binding BitrateText}" Width="94" SortMemberPath="BitRate"
                                    ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource GridHeaderRight}" />

                <DataGridTemplateColumn Header="Type" Width="128" SortMemberPath="TypeText" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding TypeTip}"
                                        Visibility="{Binding TypeText, Converter={StaticResource VisibleWhen}}">
                                <Border CornerRadius="10" Padding="9,2,9,3" VerticalAlignment="Center"
                                        Background="{Binding Type, Converter={StaticResource TypeBrush}, ConverterParameter=fill}">
                                    <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{Binding Type, Converter={StaticResource TypeBrush}}" />
                                </Border>
                                <!-- A question mark flags a low-confidence guess worth a second look -->
                                <TextBlock Text="?" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"
                                           Visibility="{Binding IsGuess, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="140" ElementStyle="{StaticResource CellText}" />

                <DataGridTemplateColumn Header="Status" Width="116" SortMemberPath="StatusText" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusTip}" Style="{StaticResource CellText}"
                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Shown instead of an empty list -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
            <TextBlock Text="Drop folders or files here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"
                       Text="Folders are scanned with all their subfolders. Every video and audio file is listed by size, recognised by type, and matched to a compression profile." />
        </StackPanel>

        <GridSplitter Grid.Row="4" Height="9" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

        <!-- Details of the selection -->
        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectionSubtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="CONTENT TYPE" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="PROFILE" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                        <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ResetSelectionCommand}" Content="Back to automatic" HorizontalAlignment="Left"
                                Foreground="{StaticResource Accent}" Padding="0,6" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ReasonsCaption}" Style="{StaticResource Caption}" />
                        <ItemsControl ItemsSource="{Binding Reasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="WHAT IS IN THE FILE" Style="{StaticResource Caption}" Margin="0,10,0,6"
                                   Visibility="{Binding StreamLines, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding StreamLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="WHAT WILL HAPPEN" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlanIsSkip}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding PlanNotes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="ffmpeg command" Margin="0,6,0,0" Visibility="{Binding PlanCommand, Converter={StaticResource VisibleWhen}}">
                            <TextBox Text="{Binding PlanCommand, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="11"
                                     BorderThickness="0" Background="Transparent" Margin="0,6,0,0" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
