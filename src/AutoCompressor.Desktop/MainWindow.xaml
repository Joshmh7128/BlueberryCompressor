<Window x:Class="AutoCompressor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCompressor.Desktop.Views"
        xmlns:c="clr-namespace:AutoCompressor.Desktop.Controls"
        Title="AutoCompressor" Icon="app.ico" Width="1400" Height="880" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Library">
                <views:LibraryView x:Name="LibraryView" DataContext="{Binding Library}" />
            </TabItem>
            <TabItem Header="{Binding Queue.TabHeader}">
                <views:QueueView x:Name="QueueView" DataContext="{Binding Queue}" />
            </TabItem>
            <TabItem Header="Profiles">
                <views:ProfilesView DataContext="{Binding Profiles}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- Status bar: what the queue is doing, visible from every tab -->
        <Border Grid.Row="1" Background="{StaticResource BgRaised}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel LastChildFill="False">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextFaint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Queue.IsRunning}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Good}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Queue.StateText}" VerticalAlignment="Center" FontSize="12" />
                <c:Bar Width="160" Height="5" Margin="14,0,0,0" VerticalAlignment="Center" Track="{StaticResource Track}" Fill="{StaticResource Accent}"
                       Fraction="{Binding Queue.OverallProgress, Converter={StaticResource PercentToFraction}}"
                       Visibility="{Binding Queue.IsRunning, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Queue.TotalsText}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" Margin="14,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
