<Application x:Class="AutoCompressor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AutoCompressor.Desktop.Controls"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette -->
            <SolidColorBrush x:Key="Bg" Color="#1B1B1F" />
            <SolidColorBrush x:Key="BgRaised" Color="#222227" />
            <SolidColorBrush x:Key="Card" Color="#26262C" />
            <SolidColorBrush x:Key="CardBorder" Color="#35353C" />
            <SolidColorBrush x:Key="Line" Color="#303037" />
            <SolidColorBrush x:Key="Text" Color="#ECECF1" />
            <SolidColorBrush x:Key="TextMuted" Color="#9A9AA6" />
            <SolidColorBrush x:Key="TextFaint" Color="#6E6E7A" />
            <SolidColorBrush x:Key="Accent" Color="#5AA9FF" />
            <SolidColorBrush x:Key="AccentSoft" Color="#5AA9FF" Opacity="0.20" />
            <SolidColorBrush x:Key="Hover" Color="#FFFFFF" Opacity="0.055" />
            <SolidColorBrush x:Key="Track" Color="#FFFFFF" Opacity="0.07" />
            <SolidColorBrush x:Key="Good" Color="#5BD08A" />
            <SolidColorBrush x:Key="Warn" Color="#F0B849" />
            <SolidColorBrush x:Key="Bad" Color="#FF7B72" />
            <SolidColorBrush x:Key="WarnSoft" Color="#F0B849" Opacity="0.13" />

            <c:TypeBrushConverter x:Key="TypeBrush" />
            <c:StateBrushConverter x:Key="StateBrush" />
            <c:VisibleWhenConverter x:Key="VisibleWhen" />
            <c:NotConverter x:Key="Not" />
            <c:PercentToFractionConverter x:Key="PercentToFraction" />

            <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

            <!-- Button content with an icon: the label is the button's Content, the glyph its Tag. Built as a
                 template so the text sits inside the button's own presenter and dims with it when disabled. -->
            <DataTemplate x:Key="IconLabel">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ButtonBase}}" FontFamily="{StaticResource Icons}"
                               VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="IconOnly">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource Icons}" />
            </DataTemplate>

            <Style x:Key="SoftListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,7" Margin="0,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A folder, drawn rather than taken from the icon font so it reads clearly at small sizes -->
            <Geometry x:Key="FolderShape">M1,3.5 C1,2.7 1.7,2 2.5,2 H6.2 L7.9,3.8 H13.5 C14.3,3.8 15,4.5 15,5.3 V12 C15,12.8 14.3,13.5 13.5,13.5 H2.5 C1.7,13.5 1,12.8 1,12 Z</Geometry>

            <!-- Text -->
            <Style x:Key="Muted" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18,16" />
            </Style>

            <!-- A button that is just an icon or a short label, for toolbars and row expanders -->
            <Style x:Key="GhostButton" TargetType="ButtonBase">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Label on the left, editor on the right, optional hint (Tag) underneath -->
            <Style x:Key="Field" TargetType="HeaderedContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource TextMuted}" Margin="0,7,12,0"
                                           VerticalAlignment="Top" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1">
                                    <ContentPresenter HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Hint}"
                                               Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Data grids: quiet headers, full-row selection, no cell chrome -->
            <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid Background="Transparent">
                                <Border Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                        <ContentPresenter RecognizesAccessKey="False" />
                                        <TextBlock x:Name="Arrow" FontFamily="{StaticResource Icons}" FontSize="8" Margin="6,3,0,0"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="7" Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="CanUserSort" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <Style x:Key="GridCell" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="Transparent" Padding="8,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="0,1" SnapsToDevicePixels="True">
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Grid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="RowHeight" Value="34" />
                <Setter Property="SelectionMode" Value="Extended" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource GridCell}" />
                <Setter Property="RowStyle" Value="{StaticResource GridRow}" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            </Style>

            <!-- Text inside grid cells -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CellTextMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            </Style>
            <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>

            <!-- Top navigation -->
            <Style x:Key="NavTab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid Margin="0,0,4,0" Background="Transparent" Cursor="Hand">
                                <Border x:Name="Bd" CornerRadius="6" Padding="14,9,14,11" Background="Transparent">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                                </Border>
                                <Border x:Name="Mark" Height="3" Width="22" CornerRadius="1.5" VerticalAlignment="Bottom"
                                        Background="{StaticResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavTabs" TargetType="TabControl">
                <Setter Property="ItemContainerStyle" Value="{StaticResource NavTab}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource BgRaised}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,6,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AutoCompressor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                                   VerticalAlignment="Center" Margin="0,0,28,5" />
                                        <TabPanel IsItemsHost="True" />
                                    </StackPanel>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Files / Folders switch -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="5" Padding="12,5" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
